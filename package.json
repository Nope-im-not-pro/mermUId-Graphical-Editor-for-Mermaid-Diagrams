{
  "name": "mermuid",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check src tests e2e scripts vite.config.ts eslint.config.js playwright.config.ts tsconfig.json && eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "license:check": "node scripts/license-check.mjs",
    "size": "node scripts/bundle-size.mjs",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run license:check && npm run size"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dagrejs/dagre": "3.1.3",
    "@lezer/highlight": "1.2.5",
    "@mermaid-js/parser": "2.0.1",
    "@xyflow/svelte": "1.7.0",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "mermaid": "12.2.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
